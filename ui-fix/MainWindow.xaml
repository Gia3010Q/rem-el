<Window x:Class="Eldorado.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eldorado · Quản lý shop" Height="780" Width="1200"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0B111C" Foreground="#E8EDF5" FontFamily="Segoe UI" FontSize="13"
        Loaded="WindowLoaded" Closing="WindowClosing" StateChanged="WindowStateChanged">
    <Window.Resources>
        <!-- ============ Bảng màu ============ -->
        <SolidColorBrush x:Key="Bg" Color="#0B111C"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#0D1524"/>
        <SolidColorBrush x:Key="CardBg" Color="#131E31"/>
        <SolidColorBrush x:Key="CardBg2" Color="#182642"/>
        <SolidColorBrush x:Key="InputBg" Color="#0B111C"/>
        <SolidColorBrush x:Key="Border" Color="#2A3649"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#1F2C42"/>
        <SolidColorBrush x:Key="Text" Color="#E8EDF5"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA8BF"/>
        <SolidColorBrush x:Key="Accent" Color="#F7C948"/>
        <SolidColorBrush x:Key="AccentDark" Color="#0B111C"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FFD968"/>
        <SolidColorBrush x:Key="Green" Color="#4ADE80"/>
        <SolidColorBrush x:Key="GreenBg" Color="#14532D"/>
        <SolidColorBrush x:Key="Blue" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="BlueBg" Color="#0C4A6E"/>
        <SolidColorBrush x:Key="Red" Color="#F87171"/>
        <SolidColorBrush x:Key="RedBg" Color="#7F1D1D"/>
        <SolidColorBrush x:Key="RowHover" Color="#1B2942"/>
        <SolidColorBrush x:Key="RowSelected" Color="#24344D"/>

        <!-- ============ Nút chính (vàng) ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A4356"/>
                    <Setter Property="Foreground" Value="#7C8AA5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Nút phụ (viền) ============ -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBg2}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#5B6B85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Nút nguy hiểm (viền đỏ) ============ -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{StaticResource Red}"/>
        </Style>

        <!-- ============ Nút điều hướng sidebar ============ -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-14,6,-14,6" Background="{StaticResource Accent}" CornerRadius="2" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBg2}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Ô nhập liệu ============ -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#5B6B85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ ComboBox ============ -->
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============ Nhãn nhỏ trên ô nhập ============ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ============ Tiêu đề mục trong thẻ ============ -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ============ Thẻ nội dung ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- ============ DataGrid tối ============ -->
        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource CardBg}"/>
            <Setter Property="AlternatingRowBackground" Value="#101A2C"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CardBg2}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Checkbox ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,26,20,10">
                    <TextBlock Text="ELDORADO" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}" LetterSpacing="2"/>
                    <TextBlock Text="Quản lý shop của bạn" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Điều hướng -->
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="MENU" FontSize="10.5" FontWeight="SemiBold" Foreground="#5B6B85" Margin="22,0,0,8"/>
                    <RadioButton x:Name="OrdersNav" GroupName="Navigation" Content="Đơn hàng" Tag="0" Style="{StaticResource NavButton}" Checked="Navigate"/>
                    <RadioButton x:Name="OffersNav" GroupName="Navigation" Content="Offer" Tag="1" Style="{StaticResource NavButton}" Checked="Navigate"/>
                    <RadioButton x:Name="BoostNav" GroupName="Navigation" Content="Cày thuê" Tag="2" Style="{StaticResource NavButton}" Checked="Navigate"/>
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Content="Kết nối shop" Tag="3" Style="{StaticResource NavButton}" Checked="Navigate"/>
                </StackPanel>

                <!-- Chân sidebar -->
                <StackPanel Grid.Row="2" Margin="20,0,20,18">
                    <Button Content="Thoát ứng dụng" Style="{StaticResource GhostButton}" Click="QuitClick"/>
                    <TextBlock Text="EldoradoDesk · v1.0.0" FontSize="11" Foreground="#5B6B85" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= NỘI DUNG CHÍNH ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header trang -->
            <Grid Grid.Row="0" Margin="28,24,28,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="PageTitle" Text="Đơn hàng" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageHint" Text="Theo dõi tối đa 50 đơn mới nhất và xác nhận giao hàng." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="⟳  Làm mới" Style="{StaticResource PrimaryButton}" Click="RefreshClick" VerticalAlignment="Center"/>
            </Grid>

            <!-- Vùng làm việc -->
            <Grid x:Name="WorkArea" Grid.Row="1" Margin="28,0,28,0">

                <!-- ============ TRANG ĐƠN HÀNG ============ -->
                <Grid x:Name="OrdersPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thanh công cụ -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBox x:Name="OrderSearch" Width="300" Style="{StaticResource FieldBox}" ToolTip="Tìm mã đơn, dịch vụ, game hoặc người mua" TextChanged="OrderFilterChanged"/>
                        <CheckBox x:Name="PendingOnly" Content="Chờ giao" Margin="18,0,0,0" Checked="OrderFilterChanged" Unchecked="OrderFilterChanged"/>
                        <CheckBox x:Name="BoostOrdersOnly" Content="Đơn cày thuê" Checked="OrderFilterChanged" Unchecked="OrderFilterChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                        <Button Content="Tin nhắn" Style="{StaticResource GhostButton}" Click="OpenChatClick" Margin="0,0,8,0"/>
                        <Button Content="Mở Dashboard" Style="{StaticResource GhostButton}" Click="OpenDashboardClick"/>
                    </StackPanel>

                    <!-- Bảng đơn -->
                    <DataGrid x:Name="OrdersGrid" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" Style="{StaticResource DarkGrid}" SelectionChanged="OrderSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DỊCH VỤ" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="NGƯỜI MUA" Binding="{Binding Buyer}" Width="130"/>
                            <DataGridTextColumn Header="GIÁ" Binding="{Binding Price, StringFormat={}{0:G29}}" Width="80"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" Background="{StaticResource CardBg2}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Paid">
                                                            <Setter Property="Background" Value="{StaticResource GreenBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Delivered">
                                                            <Setter Property="Background" Value="{StaticResource BlueBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Completed">
                                                            <Setter Property="Background" Value="{StaticResource GreenBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Canceled">
                                                            <Setter Property="Background" Value="{StaticResource RedBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding State}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="HẠN GIAO" Binding="{Binding Deadline, StringFormat={}{0:dd/MM HH:mm}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thẻ chi tiết đơn -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="CHI TIẾT ĐƠN" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="OrderDetails" Text="Chọn một đơn để xem thông tin." TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource Text}"/>
                            </ScrollViewer>
                            <Button x:Name="DeliverButton" Grid.Row="2" Content="✓  Xác nhận giao hàng" Style="{StaticResource PrimaryButton}" Click="DeliverClick" Margin="0,14,0,0" IsEnabled="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ TRANG OFFER ============ -->
                <Grid x:Name="OffersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="OfferSearch" Grid.Row="0" Grid.Column="0" Width="300" HorizontalAlignment="Left" Margin="0,0,0,14" Style="{StaticResource FieldBox}" ToolTip="Tìm offer theo tên hoặc game" TextChanged="OfferFilterChanged"/>

                    <DataGrid x:Name="OffersGrid" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" Style="{StaticResource DarkGrid}" SelectionChanged="OfferSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OFFER" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="GAME" Binding="{Binding Game}" Width="120"/>
                            <DataGridTextColumn Header="LOẠI" Binding="{Binding Kind}" Width="100"/>
                            <DataGridTextColumn Header="GIÁ" Binding="{Binding Price, StringFormat={}{0:G29}}" Width="90"/>
                            <DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding Quantity}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thẻ chi tiết + chỉnh sửa offer -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="CHI TIẾT OFFER" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="OfferDetails" Text="Chọn một offer để chỉnh sửa." TextWrapping="Wrap" LineHeight="22"/>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                <TextBlock Text="GIÁ MỚI" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OfferPrice" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                                    <Button x:Name="SavePriceButton" Grid.Column="1" Content="Lưu giá" Style="{StaticResource PrimaryButton}" Click="SavePriceClick" IsEnabled="False"/>
                                </Grid>
                                <TextBlock Text="SỐ LƯỢNG" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OfferQuantity" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                                    <Button x:Name="SaveQuantityButton" Grid.Column="1" Content="Lưu SL" Style="{StaticResource PrimaryButton}" Click="SaveQuantityClick" IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ TRANG CÀY THUÊ ============ -->
                <Grid x:Name="BoostPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Yêu cầu mới nhất từ khách — bấm vào một yêu cầu để xem mô tả đầy đủ rồi báo giá." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                        <Button Content="Mở Dashboard" Style="{StaticResource GhostButton}" Click="OpenDashboardClick" Margin="0,0,8,0"/>
                        <Button Content="Xem đơn cày thuê" Style="{StaticResource GhostButton}" Click="ShowBoostOrdersClick"/>
                    </StackPanel>

                    <!-- Bảng yêu cầu: cột mô tả hiện ngay trong danh sách -->
                    <DataGrid x:Name="RequestsGrid" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" Style="{StaticResource DarkGrid}" SelectionChanged="RequestSelected" RowHeight="64">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="YÊU CẦU CỦA KHÁCH" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="NGƯỜI MUA" Binding="{Binding Buyer}" Width="120"/>
                            <DataGridTextColumn Header="NGÀY TẠO" Binding="{Binding Created, StringFormat={}{0:dd/MM HH:mm}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thẻ chi tiết yêu cầu + báo giá -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="YÊU CẦU &amp; BÁO GIÁ" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="RequestDetails" Text="Chọn yêu cầu của khách." TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="GIÁ BÁO" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="QuotePrice" Style="{StaticResource FieldBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="TIỀN TỆ" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="QuoteCurrency" Style="{StaticResource FieldCombo}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="THỜI GIAN HOÀN THÀNH" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                <ComboBox x:Name="QuoteDelivery" Style="{StaticResource FieldCombo}"/>
                                <TextBlock x:Name="QuoteStatus" Text="Bản nháp · chưa gửi lên Eldorado" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SaveDraftButton" Content="Lưu nháp" Style="{StaticResource GhostButton}" Click="SaveDraftClick" Margin="0,0,4,0" IsEnabled="False"/>
                                    <Button x:Name="CopyQuoteButton" Grid.Column="1" Content="Sao chép" Style="{StaticResource GhostButton}" Click="CopyQuoteClick" Margin="4,0,0,0" IsEnabled="False"/>
                                </Grid>
                                <Button x:Name="SendQuoteButton" Content="Gửi báo giá" Style="{StaticResource PrimaryButton}" Click="SendQuoteClick" Margin="0,8,0,0" IsEnabled="False"/>
                                <Button x:Name="ResolveQuoteButton" Content="Đối chiếu kết quả gửi" Style="{StaticResource GhostButton}" Click="ResolveQuoteClick" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ TRANG KẾT NỐI SHOP ============ -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="560" Margin="0,8,0,0">
                        <TextBlock Text="Kết nối shop" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Thông tin kết nối được lưu an toàn trong Windows Credential Manager trên máy này." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="CLIENT ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ClientIdInput" Style="{StaticResource FieldBox}"/>
                                <TextBlock Text="CLIENT SECRET" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <PasswordBox x:Name="ClientSecretInput" Background="{StaticResource InputBg}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,8" FontSize="13"/>
                                <TextBlock x:Name="CredentialHint" Text="Nhập Client ID và Client Secret từ trang Seller API." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="Kết nối shop" Style="{StaticResource PrimaryButton}" Click="ConnectClick"/>
                                    <Button Content="Ngắt kết nối" Style="{StaticResource DangerButton}" Click="DisconnectClick" Margin="8,0,0,0"/>
                                    <Button Content="Mở trang Seller API" Style="{StaticResource GhostButton}" Click="OpenSellerApiClick" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="REM · TỰ ĐỘNG NHẬN ĐƠN" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="AutoQuoteCheck" Content="Tự động gửi báo giá khi app định giá được yêu cầu" Margin="0,10,0,0" IsChecked="True" Checked="AutoQuoteChanged" Unchecked="AutoQuoteChanged"/>
                                <TextBlock Text="Rem chỉ báo giá khi khớp chắc chắn với bảng giá. Yêu cầu lạ, trade, mặc cả hay món đã gỡ khỏi shop sẽ được giữ lại để bạn quyết định — app không tự giao hàng bao giờ." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
                                <TextBlock Text="DISCORD WEBHOOK — NHẬN THÔNG BÁO ĐƠN MỚI" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WebhookInput" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                                    <Button x:Name="SaveWebhookButton" Content="Lưu webhook" Style="{StaticResource PrimaryButton}" Click="SaveWebhookClick"/>
                                </Grid>
                                <TextBlock x:Name="WebhookHint" Text="Dán webhook Discord của bạn để app báo đơn mới, báo giá đã gửi và yêu cầu cần bạn xem." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ĐỒNG BỘ TỰ ĐỘNG" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="App kiểm tra đơn hàng và yêu cầu mới mỗi 15 giây, offer mỗi 60 giây. Khi Eldorado giới hạn lượt gọi, app sẽ chờ lâu hơn. Mỗi lần chỉ tải 50 bản ghi mới nhất. Lượng tin nhắn mới không thông báo ở đây — mở Dashboard để xem." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
                                <TextBlock Text="Thu nhỏ cửa sổ sẽ ẩn app xuống khay hệ thống. Chọn Thoát trong menu khay để đóng hẳn." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Thanh trạng thái -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="28,12">
                <TextBlock x:Name="StatusText" Text="Chưa kết nối shop. Nhập credentials để bắt đầu." Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
